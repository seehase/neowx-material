#encoding UTF-8
## +-------------------------------------------------------------------------+
## |    earthquakes.html.tmpl         Template for local earthquakes page    |
## +-------------------------------------------------------------------------+

#attr $page = 'earthquakes'
#attr $subpage = 'earthquakes'

#if not $varExists('base_path')
    #set $base_path = ''
#end if

<!DOCTYPE html>
<html lang="$lang">
<head>
    <title>$gettext("earthquakes") | $station.location</title>
    #include "inc/head.inc"
</head>
<body class="${Extras.Appearance.mode}-theme main-bg" ontouchstart="">

#attr $active_nav = 'earthquakes'
#include "inc/header.inc"

#set $radius_km = $Extras.get("Earthquakes", {}).get("radius_km", 300)
#set $min_mag = $Extras.get("Earthquakes", {}).get("min_magnitude", 2.5)
#set $timespan_days = $Extras.get("Earthquakes", {}).get("timespan_days", 7)
#set $basemap = $Extras.get("Earthquakes", {}).get("basemap", "vector")
#set $custom_tile_url = $Extras.get("Earthquakes", {}).get("custom_tile_url", "")
#set $show_faults = $Extras.get("Earthquakes", {}).get("show_faults", "yes")

<main class="container-fluid mt-4 mb-4">
    <div class="row">

        <!-- Left Column: Summary Badges & Scrollable Event List -->
        <div class="col-12 col-lg-5 mb-4">
            <div class="card mb-3">
                <div class="card-body p-3 text-center">
                    <div class="row">
                        <div class="col-4 border-right">
                            <div class="text-muted font-small text-uppercase">Events ($timespan_days d)</div>
                            <h4 class="h3-responsive font-weight-bold mb-0 $Extras.color-text" id="quake-total-count">-</h4>
                        </div>
                        <div class="col-4 border-right">
                            <div class="text-muted font-small text-uppercase">Max Mag</div>
                            <h4 class="h3-responsive font-weight-bold mb-0 text-danger" id="quake-max-mag">-</h4>
                        </div>
                        <div class="col-4">
                            <div class="text-muted font-small text-uppercase">Latest</div>
                            <h4 class="h3-responsive font-weight-bold mb-0 $Extras.color-text" id="quake-latest-time">-</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold $Extras.color-text">
                        <i class="mdi mdi-format-list-bulleted mr-1"></i> $gettext("earthquakes") (&ge; M$min_mag)
                    </span>
                    <span class="badge badge-light font-small">$radius_km km radius</span>
                </div>
                <div class="card-body p-0 quake-list-scroll" id="earthquake-list">
                    <div class="p-4 text-center text-muted font-small">
                        <div class="spinner-border spinner-border-sm text-primary mr-2" role="status"></div>
                        Loading earthquake feed from USGS...
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Interactive Leaflet Map -->
        <div class="col-12 col-lg-7 mb-4">
            <div class="card">
                <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold $Extras.color-text">
                        <i class="mdi mdi-map-marker-radius-outline mr-1"></i> Regional Seismic Map
                    </span>
                    <a href="https://earthquake.usgs.gov/earthquakes/map/?extent=59.10838,-153.4021&extent=63.48493,-144.85474&range=week&magnitude=2.5&listOnlyShown=true&baseLayer=terrain"
                       target="_blank" rel="noopener" class="font-small font-weight-bold $Extras.color-text">
                        Open on USGS &rarr;
                    </a>
                </div>
                <div class="card-body p-2">
                    <div id="earthquake-map" class="earthquake-page-map"
                         data-lat="$station.latitude_f"
                         data-lon="$station.longitude_f"
                         data-station-name="$station.location"
                         data-radius="$radius_km"
                         data-minmag="$min_mag"
                         data-timespan="$timespan_days"
                         data-basemap="$basemap"
                         data-tile-url="$custom_tile_url"
                         data-show-faults="$show_faults"
                         data-theme-mode="${Extras.Appearance.mode}"
                         data-theme-color="$Extras.color">
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

#include "inc/footer.inc"
#include "inc/js.inc"
</body>
</html>
