## +-------------------------------------------------------------------------+
## | The main page layout                                                    |
## +-------------------------------------------------------------------------+

<!DOCTYPE html>
<html lang="$lang">
    <head>
        <title>$gettext("telemetry") | $station.location</title>
        #include "head.inc"
    </head>
    <body class="${Extras.Appearance.mode}-theme main-bg" ontouchstart="">

        #attr $active_nav = ''
        #include "header.inc"

        #set global $card_scope = $page
        #set global $card_default = $Extras.Formatting.datetime_today
        #include "card_datetime.inc"

        ## Resolve the page tick spec once (tick_style_telemetry -> tick_style ->
        ## auto). All telemetry charts share the same span (Telemetry.chart_days,
        ## 30 in the shipped config; 1 if unset). Snap the start to midnight so the
        ## day-tier ticks land on midnight (not the current time-of-day).
        #set global $_tel_chart_days = 1
        #try
            #set global $_tel_chart_days = int($getVar('Extras.Telemetry.chart_days', '1'))
        #except
            #set global $_tel_chart_days = 1
        #end try
        #set global $align_start = $span($day_delta=$_tel_chart_days, $boundary='midnight').start.raw
        #set global $align_stop = $current.dateTime.raw
        #include "graph_align_setup.inc"
        <main>
            <div class="container-fluid d-flex-xxl">

                <div class="row my-4 temprow align-content-start">

                    <div class="col-12 mb-4 text-center">
                        <h2 class="h2-responsive text-dark">$gettext("telemetry")</h2>
                    </div>

                    #set $tele_val_segments = $panelSegments('telemetry', page=$page, subpage=$subpage)
                    #set $tele_val_idx = 0
                    #for $seg_i, $seg in $enumerate($tele_val_segments)
                        #if $seg['type'] is not None
                            #set $tele_val_idx = $tele_val_idx + 1
                        #end if
                        ## Section boundary. A col-12 fills a whole flex line, so this is
                        ## what makes each section start on a fresh row. Panels are col-12
                        ## already; plain sections need it emitted explicitly.
                        #if $seg_i > 0
                            <div class="col-12"></div>
                        #end if
                        $renderTeleSegment($seg, $tele_val_idx, 'value')
                    #end for

                </div>

                <hr class="m-0 mb-4 rowdivider">

                <div class="row mt-3 graphrow align-content-start">

                    #set $tele_chart_segments = $panelSegments('telemetry_chart', page=$page, subpage=$subpage)
                    #set $tele_chart_idx = 0
                    #for $seg_i, $seg in $enumerate($tele_chart_segments)
                        #if $seg['type'] is not None
                            #set $tele_chart_idx = $tele_chart_idx + 1
                        #end if
                        ## Section boundary. A col-12 fills a whole flex line, so this is
                        ## what makes each section start on a fresh row. Panels are col-12
                        ## already; plain sections need it emitted explicitly.
                        #if $seg_i > 0
                            <div class="col-12"></div>
                        #end if
                        $renderTeleSegment($seg, $tele_chart_idx, 'chart')
                    #end for

                </div>

                #include "embedded_region.inc"
            </div>
        </main>

        #include "footer.inc"
        #include "js.inc"

        ## +-------------------------------------------------------------------------+
        ## | Chart definitions                                                       |
        ## +-------------------------------------------------------------------------+

        <script type="text/javascript">
            // Config templates

            var graph_area_config = {
                #include "graph_area_config.inc"
            }

            #set global $tele_mode        = 'js'
            #set global $tele_chart_items = $panelItems('telemetry_chart', page=$page, subpage=$subpage)
            #include "telemetry.inc"
        </script>

    </body>
</html>
